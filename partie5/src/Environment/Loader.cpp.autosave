#include "Loader.hpp"
#include "Anthill.hpp"
#include "Food.hpp"
#include "Termite.hpp"
#include "Utility/Utility.hpp"

void loadMap(std::string const& filepath){

std::ifstream file(filepath);
std::string maison = "anthill";
std::string term = "termite";
std::string nour = "food";

std::string posx;
std::string posy;
std::string space;
std::string quantite;
int test(0);

std::string nom;
if (file){
    std::string line;

    while(std::getline(file, line)){
        std::stringstream p(line);
        std::cout << line << std::endl;
       // std::cout << test << std::endl;
        if (line[0] == '#'){
            continue;
        }
        if (line.empty()){
            continue;
        }
        for (size_t i(0); i< maison.size() ; ++i){
            if (line[i]== maison[i]){
                 test = 1;
            }
        }
        if (test == 1){
                p >> nom >> posx >> posy;
                //std::cout << nom << posx <<posy << std::endl;
                int x2 = std::stoi(posx);
                int y2 = std::stoi(posy);
                 Vec2d nouvpos(x2, y2);
                getAppEnv().addAnthill(new Anthill(nouvpos));
            }
        for (size_t i(0); i< term.size() ; ++i){
            if (line[i]== term[i]){
                test = 2;
            }
        }
        if (test ==2){
           p >> nom>> posx >> posy;
           //std::cout << nom << posx <<posy << std::endl;
           int x1 = std::stoi(posx);
           int y1 = std::stoi(posy);
            Vec2d nouvpos1(x1, y1);
            getAppEnv().addAnimal(new Termite(nouvpos1));
        }
// problème de compilation avec la nourriture à regler

        for (size_t i(0); i< nour.size() ; ++i){
            if (line[i]== nour[i]){
                 test = 3;
            }
        }
        if (test == 3){
            std::string quantit;
                p >> nom;
                p >> posx;
                p >> posy;
                p >> quantite;

                int x3 = std::stoi(posx);
                int y3 = std::stoi(posy);
                Vec2d nouvpos3(x3, y3);
                for (size_t i(nom.size() + posx.size() + posy.size()); i<line.size(); ++i){
                    quantit.push_back(line[i]);
                }
                std::cout << "test = " <<"-"<< quantit <<"-" << std::endl;

                getAppEnv().addFood(new Food(nouvpos3, std::stoi(quantit)));
            }

    }
    file.close();

}else {
    std::cerr << "Erreur impossible d'ouvrir ke fichier"<< std::endl;

}
}
